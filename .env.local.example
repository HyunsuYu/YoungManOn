# ── 온통청년 오픈 API ────────────────────────────────────────
# https://www.youthcenter.go.kr 오픈API 신청 후 발급
# 없으면 /api/policies 는 목업 데이터로 폴백합니다.
YOUTH_API_KEY=

# ── AI 자연어 검색 (둘 중 하나만 있으면 됩니다) ─────────────
# 기본 제공자: Gemini — https://aistudio.google.com 에서 무료 발급
GEMINI_API_KEY=
# 사용할 모델 (기본: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# 대안: Claude — https://console.anthropic.com (유료 크레딧 필요)
ANTHROPIC_API_KEY=

# 둘 다 없으면 AI 검색만 비활성화되고 나머지 기능은 정상 동작합니다.

# 로컬 개발 시 이 파일을 .env.local 로 복사해 값을 채우세요.
# Vercel 배포 시에는 프로젝트 Settings > Environment Variables 에 동일하게 등록합니다.
