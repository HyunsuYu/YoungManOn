# ── 데이터 소스 설정 ─────────────────────────────────────────
# 목업 데이터로 시작할 때는 아래를 mock 으로 둡니다.
# 실제 API 키를 발급받으면 youthcenter 로 바꾸고 키를 채워주세요.
#   - mock        : src/data/mockPolicies.ts 의 샘플 데이터 사용
#   - youthcenter : 온통청년(youthcenter.go.kr) 청년정책 통합 API 사용
POLICY_SOURCE=mock

# 온통청년 오픈 API 키 (https://www.youthcenter.go.kr 오픈API 신청 후 발급)
# POLICY_SOURCE=youthcenter 일 때만 사용됩니다.
YOUTH_API_KEY=
